# Le secret de session est généré et conservé dans le dossier de données local.
# Il n'existe volontairement aucun override AURELIA_SESSION_SECRET en production.
# Chemin SQLite optionnel. En production, laisser vide pour %LOCALAPPDATA%\Aurelia.
AURELIA_DB_PATH=

# Gmail OAuth
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=
GMAIL_QUERY=has:attachment newer_than:30d
GMAIL_CREATE_DRAFTS_ONLY=true

# OCR
TESSERACT_CMD=
OCR_LANG=fra+eng+spa

# Pennylane
PENNYLANE_BASE_URL=
PENNYLANE_API_TOKEN=

# Sage
SAGE_BASE_URL=
SAGE_ACCESS_TOKEN=
SAGE_BUSINESS_ID=

# Cegid
CEGID_BASE_URL=
CEGID_API_KEY=
CEGID_SUBSCRIPTION_KEY=
CEGID_DOSSIER_CODE=

# EBP
EBP_EXPORT_MODE=csv

# Plateforme agréée
PA_BASE_URL=
PA_API_TOKEN=
